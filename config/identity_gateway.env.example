# 157: all gateway features default OFF; migrate before enabling.
# Populate through server secrets; never commit actual values.
CHAOS_IDENTITY_PUBLIC_ORIGIN=https://chaos.re
CHAOS_IDENTITY_ENABLED=0
CHAOS_IDENTITY_REGISTRATION_ENABLED=0
CHAOS_IDENTITY_LINKING_ENABLED=0
CHAOS_IDENTITY_GOOGLE_ENABLED=0
CHAOS_IDENTITY_GOOGLE_CLIENT_ID=
CHAOS_IDENTITY_GOOGLE_CLIENT_SECRET=
CHAOS_IDENTITY_DISCORD_ENABLED=0
CHAOS_IDENTITY_DISCORD_CLIENT_ID=
CHAOS_IDENTITY_DISCORD_CLIENT_SECRET=
CHAOS_IDENTITY_GITHUB_ENABLED=0
CHAOS_IDENTITY_GITHUB_CLIENT_ID=
CHAOS_IDENTITY_GITHUB_CLIENT_SECRET=
# Steam OpenID 2.0: no OAuth client secret and no profile Web API key required.
CHAOS_IDENTITY_STEAM_ENABLED=0
# Fallback defaults only. Admin -> Identity Gateway -> Mail overrides these
# after saving. SMTP password is encrypted using the stable CHAOS_SECRET_KEY.
# Disabled is intentional, not simulated delivery.
CHAOS_IDENTITY_MAIL_MODE=disabled
CHAOS_IDENTITY_SMTP_HOST=
CHAOS_IDENTITY_SMTP_PORT=587
CHAOS_IDENTITY_SMTP_TLS=starttls
CHAOS_IDENTITY_MAIL_FROM=
CHAOS_IDENTITY_SMTP_USERNAME=
CHAOS_IDENTITY_SMTP_PASSWORD=
