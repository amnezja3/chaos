    "creator.legacy.narrative.0.title": {
      "params": {},
      "text": "Give the tool an identity"
    },
    "creator.legacy.narrative.0.subtitle": {
      "params": {},
      "text": "The first signal for players and the Googleplex catalog."
    },
    "creator.legacy.narrative.0.description": {
      "params": {},
      "text": "The name, icon and description explain the app before anyone reads its contract."
    },
    "creator.legacy.narrative.0.educational_note": {
      "params": {},
      "text": "Tools of this class are recognised by their purpose, scope and clear description."
    },
    "creator.legacy.narrative.0.gameplay_hint": {
      "params": {},
      "text": "The price is a starting point. The balance preview may suggest a different value."
    },
    "creator.legacy.narrative.1.title": {
      "params": {},
      "text": "Choose a tool family"
    },
    "creator.legacy.narrative.1.subtitle": {
      "params": {},
      "text": "The family narrows the next choices."
    },
    "creator.legacy.narrative.1.description": {
      "params": {},
      "text": "Scanner / Recon also includes target tracing. Exploit and Sniffer are separate gameplay families."
    },
    "creator.legacy.narrative.1.educational_note": {
      "params": {},
      "text": "Security teams use similar classes of tools to discover, control and observe systems."
    },
    "creator.legacy.narrative.1.gameplay_hint": {
      "params": {},
      "text": "For Trace target choose Scanner / Recon / Tracing, the tracer type and the trace action."
    },
    "creator.legacy.narrative.2.title": {
      "params": {},
      "text": "Choose the target"
    },
    "creator.legacy.narrative.2.subtitle": {
      "params": {},
      "text": "The target determines which options apply."
    },
    "creator.legacy.narrative.2.description": {
      "params": {},
      "text": "Vehicles, cameras and routers require different tool contracts."
    },
    "creator.legacy.narrative.2.educational_note": {
      "params": {},
      "text": "CHAOS objects expose different signals: location, image, network traffic, logs or access."
    },
    "creator.legacy.narrative.2.gameplay_hint": {
      "params": {},
      "text": "The creator hides operations and information that do not match the target."
    },
    "creator.legacy.narrative.3.title": {
      "params": {},
      "text": "Choose where to launch"
    },
    "creator.legacy.narrative.3.subtitle": {
      "params": {},
      "text": "Map, desktop or both."
    },
    "creator.legacy.narrative.3.description": {
      "params": {},
      "text": "A tool does not need a map menu entry. Desktop tools can use the marked target."
    },
    "creator.legacy.narrative.3.educational_note": {
      "params": {},
      "text": "The context matters: work on a world object or an already selected target."
    },
    "creator.legacy.narrative.3.gameplay_hint": {
      "params": {},
      "text": "Desktop mode may have no map action. Map mode needs explicit map_actions."
    },
    "creator.legacy.narrative.4.title": {
      "params": {},
      "text": "Choose what the tool does"
    },
    "creator.legacy.narrative.4.subtitle": {
      "params": {},
      "text": "The operation contract starts here."
    },
    "creator.legacy.narrative.4.description": {
      "params": {},
      "text": "Choose a gameplay effect: tracking, streaming, reading, interference or an implant."
    },
    "creator.legacy.narrative.4.educational_note": {
      "params": {},
      "text": "Describe the effect in the simulated game world."
    },
    "creator.legacy.narrative.4.gameplay_hint": {
      "params": {},
      "text": "An operation may appear on the map, have a timer, produce data or support another process."
    },
    "creator.legacy.narrative.5.title": {
      "params": {},
      "text": "Choose what information it seeks"
    },
    "creator.legacy.narrative.5.subtitle": {
      "params": {},
      "text": "Data fuels the CHAOS economy."
    },
    "creator.legacy.narrative.5.description": {
      "params": {},
      "text": "Resources determine the files or state that an operation can produce."
    },
    "creator.legacy.narrative.5.educational_note": {
      "params": {},
      "text": "These tool classes help explain the signals and metadata present in systems."
    },
    "creator.legacy.narrative.5.gameplay_hint": {
      "params": {},
      "text": "Some resources cannot be sold. internal_recon_state may only prepare another action."
    },
    "creator.legacy.narrative.6.title": {
      "params": {},
      "text": "Set risk and dependencies"
    },
    "creator.legacy.narrative.6.subtitle": {
      "params": {},
      "text": "Every tool has traces and requirements."
    },
    "creator.legacy.narrative.6.description": {
      "params": {},
      "text": "Specify conflicts, disabled protections and conditions required before use."
    },
    "creator.legacy.narrative.6.educational_note": {
      "params": {},
      "text": "Design includes understanding limitations as well as capabilities."
    },
    "creator.legacy.narrative.6.gameplay_hint": {
      "params": {},
      "text": "These are game contract fields; they do not introduce a new risk system."
    },
    "creator.legacy.narrative.7.title": {
      "params": {},
      "text": "Review the contract"
    },
    "creator.legacy.narrative.7.subtitle": {
      "params": {},
      "text": "Preview your choices as one app."
    },
    "creator.legacy.narrative.7.description": {
      "params": {},
      "text": "See how family, target, action and data form the app contract."
    },
    "creator.legacy.narrative.7.educational_note": {
      "params": {},
      "text": "A clear tool design should be understandable without reading code."
    },
    "creator.legacy.narrative.7.gameplay_hint": {
      "params": {},
      "text": "Size, quality, reliability and suggested price are calculated by the runtime."
    },
    "creator.legacy.narrative.8.title": {
      "params": {},
      "text": "Publish in Googleplex"
    },
    "creator.legacy.narrative.8.subtitle": {
      "params": {},
      "text": "The same catalog and runtime."
    },
    "creator.legacy.narrative.8.description": {
      "params": {},
      "text": "Publishing uses the existing endpoint and Googleplex catalog."
    },
    "creator.legacy.narrative.8.educational_note": {
      "params": {},
      "text": "A tool belongs to an ecosystem: design, publish, install, use and uninstall."
    },
    "creator.legacy.narrative.8.gameplay_hint": {
      "params": {},
      "text": "After publishing, buy and install the app like any other tool."
    },
