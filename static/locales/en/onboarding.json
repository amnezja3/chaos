    "onboarding.story.0.title": {
      "params": {},
      "text": "GHOSTSYSTEM // a package from the past"
    },
    "onboarding.story.0.text": {
      "params": {},
      "text": "The year is 2108. MASA controls cities, routes, banks and private memories. You have just received a package that should not exist in any registry. First step: choose a username."
    },
    "onboarding.story.1.title": {
      "params": {},
      "text": "Factions // who will you trust"
    },
    "onboarding.story.1.text": {
      "params": {},
      "text": "GhostSystem survived through dispersed factions. Each sees the network differently and pays a different price for its edge. Choose the banner under which you will begin your operations."
    },
    "onboarding.story.2.title": {
      "params": {},
      "text": "Role // your first trace"
    },
    "onboarding.story.2.text": {
      "params": {},
      "text": "Your faction gives you direction, but your role defines your approach. Will you read traffic, protect access, manipulate the market or disappear from radar? Choose your operator."
    },
    "onboarding.story.3.title": {
      "params": {},
      "text": "Key // secure your access"
    },
    "onboarding.story.3.text": {
      "params": {},
      "text": "Your password is the first barrier against someone else’s terminal. It does not have to be beautiful. It must be hard to guess and strong enough to buy you time."
    },
    "onboarding.story.4.title": {
      "params": {},
      "text": "Contact // dead drop"
    },
    "onboarding.story.4.text": {
      "params": {},
      "text": "Provide a recovery channel. The system will use it as a hidden synchronization point. If you ever lose access, it may be the only thing left."
    },
    "onboarding.story.5.title": {
      "params": {},
      "text": "Alias // enter the city"
    },
    "onboarding.story.5.text": {
      "params": {},
      "text": "Your profile is almost ready. Choose a nickname, review your choices and start installation. Your starting location will be assigned automatically from your IP address or a list of active cities."
    },
    "onboarding.faction.1.name": {
      "params": {},
      "text": "Guardians of Order"
