    "creator.legacy.narrative.0.title": {
      "params": {},
      "text": "Nadaj narzędziu tożsamość"
    },
    "creator.legacy.narrative.0.subtitle": {
      "params": {},
      "text": "Pierwszy sygnal dla gracza i katalogu Googleplex."
    },
    "creator.legacy.narrative.0.description": {
      "params": {},
      "text": "Nazwa, ikona i opis mowia, czym jest aplikacja zanim ktokolwiek spojrzy w jej kontrakt."
    },
    "creator.legacy.narrative.0.educational_note": {
      "params": {},
      "text": "Profesjonalne narzędzia tej klasy są rozpoznawalne po celu, zakresie i wiarygodnym opisie."
    },
    "creator.legacy.narrative.0.gameplay_hint": {
      "params": {},
      "text": "Cena jest punktem startu. Runtime moze pokazac sugerowana wartosc w podgladzie balansu."
    },
    "creator.legacy.narrative.1.title": {
      "params": {},
      "text": "Wybierz rodzinę narzędzia"
    },
    "creator.legacy.narrative.1.subtitle": {
      "params": {},
      "text": "Rodzina zawedza dalsze decyzje."
    },
    "creator.legacy.narrative.1.description": {
      "params": {},
      "text": "Scanner / Recon obejmuje także namierzanie celu (trace). Exploit i Sniffer pozostają osobnymi rodzinami gameplayowymi."
    },
    "creator.legacy.narrative.1.educational_note": {
      "params": {},
      "text": "Administratorzy i zespoly bezpieczenstwa uzywaja podobnych klas rozwiazan do rozpoznania, kontroli i obserwacji systemow."
    },
    "creator.legacy.narrative.1.gameplay_hint": {
      "params": {},
      "text": "Dla akcji mapy Namierz cel wybierz Scanner / Recon / Namierzanie, typ Tracer / tracker oraz działanie Namierz cel (trace)."
    },
    "creator.legacy.narrative.2.title": {
      "params": {},
      "text": "Wskaz obiekt zainteresowania"
    },
    "creator.legacy.narrative.2.subtitle": {
      "params": {},
      "text": "Cel decyduje, jakie opcje maja sens."
    },
    "creator.legacy.narrative.2.description": {
      "params": {},
      "text": "Inaczej projektuje się narzędzie dla pojazdu, inaczej dla kamery, a inaczej dla routera."
    },
    "creator.legacy.narrative.2.educational_note": {
      "params": {},
      "text": "W swiecie CHAOS kazdy obiekt ma inne cyfrowe zmysly: lokalizacje, obraz, sygnal, logi albo dostep."
    },
    "creator.legacy.narrative.2.gameplay_hint": {
      "params": {},
      "text": "Po wyborze celu kreator ukrywa niepasujace operacje i informacje."
    },
    "creator.legacy.narrative.3.title": {
      "params": {},
      "text": "Okresl miejsce uruchomienia"
    },
    "creator.legacy.narrative.3.subtitle": {
      "params": {},
      "text": "Mapa, desktop albo oba tryby."
    },
    "creator.legacy.narrative.3.description": {
      "params": {},
      "text": "Nie każde narzędzie musi być widoczne w menu mapy. Desktop może działać na oznaczony cel."
    },
    "creator.legacy.narrative.3.educational_note": {
      "params": {},
      "text": "To rozróżnienie przypomina pracę z kontekstem: czasem działasz na obiekcie w terenie, czasem na już wybranym celu."
    },
    "creator.legacy.narrative.3.gameplay_hint": {
      "params": {},
      "text": "Tryb desktopowy moze nie miec akcji mapy. Tryb mapowy powinien miec jawne map_actions."
    },
    "creator.legacy.narrative.4.title": {
      "params": {},
      "text": "Zdecyduj, co narzędzie ma zrobić"
    },
    "creator.legacy.narrative.4.subtitle": {
      "params": {},
      "text": "To jest serce kontraktu operacji."
    },
    "creator.legacy.narrative.4.description": {
      "params": {},
      "text": "Wybierasz efekt gameplayowy: sledzenie, stream, odczyt, zaklocenie albo implant."
    },
    "creator.legacy.narrative.4.educational_note": {
      "params": {},
      "text": "Nie chodzi o realne komendy. Chodzi o opis skutku w symulowanym swiecie gry."
    },
    "creator.legacy.narrative.4.gameplay_hint": {
      "params": {},
      "text": "Operacja moze zyc na mapie, miec timer, produkowac dane albo tylko wspierac inny proces."
    },
    "creator.legacy.narrative.5.title": {
      "params": {},
      "text": "Wybierz informacje, ktorych szuka"
    },
    "creator.legacy.narrative.5.subtitle": {
      "params": {},
      "text": "Dane sa paliwem ekonomii CHAOS."
    },
    "creator.legacy.narrative.5.description": {
      "params": {},
      "text": "Zasoby okreslaja, jaki typ pliku albo stanu moze powstac po operacji."
    },
    "creator.legacy.narrative.5.educational_note": {
      "params": {},
      "text": "Podobne klasy narzędzi w realnym świecie pomagają zrozumieć, jakie sygnały i metadane istnieją w systemach."
    },
    "creator.legacy.narrative.5.gameplay_hint": {
      "params": {},
      "text": "Nie każdy zasób jest sprzedawalny. `internal_recon_state` może tylko przygotować dalsze działanie."
    },
    "creator.legacy.narrative.6.title": {
      "params": {},
      "text": "Ustal ryzyko i zaleznosci"
    },
    "creator.legacy.narrative.6.subtitle": {
      "params": {},
      "text": "Każde narzędzie ma ślady i wymagania."
    },
    "creator.legacy.narrative.6.description": {
      "params": {},
      "text": "Ten krok opisuje, z czym narzędzie koliduje, co wyłącza i jakie warunki powinny być spełnione."
    },
    "creator.legacy.narrative.6.educational_note": {
      "params": {},
      "text": "Świadome projektowanie narzędzia polega też na rozumieniu ograniczeń, nie tylko możliwości."
    },
    "creator.legacy.narrative.6.gameplay_hint": {
      "params": {},
      "text": "To nadal sa pola kontraktu gry. Nie tworza realnych instrukcji ani nowego systemu ryzyka."
    },
    "creator.legacy.narrative.7.title": {
      "params": {},
      "text": "Sprawdz kontrakt przed publikacja"
    },
    "creator.legacy.narrative.7.subtitle": {
      "params": {},
      "text": "Podglad laczy decyzje w jedna aplikacje."
    },
    "creator.legacy.narrative.7.description": {
      "params": {},
      "text": "Tutaj widzisz, jak wybór rodziny, celu, działania i danych zamienia się w app contract."
    },
    "creator.legacy.narrative.7.educational_note": {
      "params": {},
      "text": "Dobry projekt narzędzia powinien być czytelny bez zaglądania w kod."
    },
    "creator.legacy.narrative.7.gameplay_hint": {
      "params": {},
      "text": "Waga, jakosc, niezawodnosc i cena sugerowana sa liczone przez runtime."
    },
    "creator.legacy.narrative.8.title": {
      "params": {},
      "text": "Opublikuj w Googleplex"
    },
    "creator.legacy.narrative.8.subtitle": {
      "params": {},
      "text": "Ten sam katalog, ten sam runtime."
    },
    "creator.legacy.narrative.8.description": {
      "params": {},
      "text": "Publikacja uzywa istniejacego endpointu i trafia do tego samego Googleplexa co inne aplikacje."
    },
    "creator.legacy.narrative.8.educational_note": {
      "params": {},
      "text": "CHAOS traktuje narzędzie jak element ekosystemu: projekt, publikacja, instalacja, użycie i uninstall."
    },
    "creator.legacy.narrative.8.gameplay_hint": {
      "params": {},
      "text": "Po publikacji aplikację kupujesz i instalujesz tak jak inne narzędzia."
    },
